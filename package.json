{
  "name": "unlv-economics-working-paper-series-site",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "npm run verify:paper-content && npm run verify:publication-utilities && astro build && npm run verify:text-contracts && npm run verify:governance-copy && npm run verify:public-ia",
    "preview": "astro preview",
    "astro": "astro",
    "migrate:papers": "tsx scripts/migrate-paper-metadata.ts --dry-run",
    "migrate:papers:write": "tsx scripts/migrate-paper-metadata.ts --write",
    "generate:homepage-content": "tsx scripts/markdown-to-homepage-content.ts",
    "verify:text-contracts": "tsx scripts/verify-text-contracts.ts",
    "verify:governance-copy": "tsx scripts/verify-governance-copy.ts",
    "verify:public-ia": "tsx scripts/verify-public-ia.ts",
    "verify:paper-content": "tsx scripts/migrate-paper-metadata.ts --dry-run",
    "verify:publication-utilities": "node scripts/verify-publication-utilities.mjs"
  },
  "dependencies": {
    "astro": "^5.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-basic-ssl": "^2.1.4",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
