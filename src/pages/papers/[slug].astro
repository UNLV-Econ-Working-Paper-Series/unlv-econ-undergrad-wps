---
import PageBanner from "../../components/PageBanner.astro";
import { OASIS_MIRROR_ACTIVE } from "../../config/repositoryStatus";
import { categorySlugForName } from "../../data/categories";
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  cleanPaperTitle,
  formatCitations,
  formatPaperDate,
  getAllPapers,
  getIssueLabelForPaper,
  getIssueSlugForPaper,
  paperPdfHref,
  paperSlug,
  repositoryIssueLabel,
} from "../../lib/papers";
import { withBase } from "../../lib/urls";

export async function getStaticPaths() {
  const papers = await getAllPapers();
  return papers.map((paper) => ({ params: { slug: paperSlug(paper) }, props: { paper } }));
}

const { paper } = Astro.props;
const title = cleanPaperTitle(paper.data.title);
const issueLabel = getIssueLabelForPaper(paper);
const issueSlug = getIssueSlugForPaper(paper);
const categorySlug = categorySlugForName(paper.data.category);
const citations = formatCitations(paper);
const defaultCitation = citations[0];
const pdfHref = paperPdfHref(paper);
const oasisUrl = paper.data.oasis_url?.trim();
const showOasisLink = OASIS_MIRROR_ACTIVE && Boolean(oasisUrl);
const authorsDisplay = paper.data.authors.join(", ");
const publicationLabel = formatPaperDate(paper.data.published_at);
const repositoryLabel = repositoryIssueLabel(paper);
const doiHref = paper.data.doi ? `https://doi.org/${paper.data.doi}` : null;
---

<BaseLayout
  title={`${title} | Papers`}
  description={paper.data.abstract}
  bodyClass="section-papers page-paper-detail"
>
  <div class="paper-page">
    <nav class="paper-breadcrumb content-section" aria-label="Breadcrumb" data-motion="gsap">
      <ol>
        <li><a href={withBase("/papers/")}>Papers</a></li>
        <li><a href={withBase(`/issues/${issueSlug}/`)}>{issueLabel}</a></li>
        <li><span aria-current="page">{title}</span></li>
      </ol>
    </nav>

    <PageBanner
      class="paper-record-masthead"
      kicker="Undergraduate economics working paper"
      title={title}
      subtitle={`${authorsDisplay} • ${issueLabel} • ${publicationLabel}`}
    />

    <div class="paper-detail-toolbar content-section" data-motion="gsap">
      <nav class="paper-detail-quick-actions" aria-label="Paper actions">
        <a class="btn btn-primary" href={pdfHref}>Read full paper (PDF)</a>
        {showOasisLink ? (
          <a class="btn btn-small btn-outline" href={oasisUrl} rel="external">View OASIS record</a>
        ) : null}
      </nav>
      {doiHref ? (
        <p class="paper-detail-toolbar__doi">
          Permanent link: <a href={doiHref} rel="external">doi.org/{paper.data.doi}</a>
        </p>
      ) : null}
    </div>

    <article class="paper-detail-layout content-section" data-motion="gsap">
      <div class="paper-detail-main">
        <section class="paper-detail-section paper-abstract-card" aria-labelledby="paper-abstract-title">
          <p class="paper-library-eyebrow">Research summary</p>
          <h2 id="paper-abstract-title">Abstract</h2>
          <p class="paper-detail-abstract">{paper.data.abstract}</p>
        </section>

        <section class="paper-detail-section paper-citation-card" aria-labelledby="paper-citation-heading">
          <details class="paper-citation-disclosure">
            <summary>
              <span class="paper-citation-summary-copy">
                <span class="paper-library-eyebrow">Citation tools</span>
                <span id="paper-citation-heading" class="paper-citation-summary-title" role="heading" aria-level="2">
                  Cite this paper
                </span>
              </span>
              <span class="paper-citation-summary-action">
                <span class="paper-citation-summary-closed">Show citation options</span>
                <span class="paper-citation-summary-open">Hide citation options</span>
                <span class="paper-citation-summary-icon" aria-hidden="true"></span>
              </span>
            </summary>

            <div class="paper-citation-panel">
              <div class="paper-citation-controls">
                <div class="paper-citation-style">
                  <label for="paper-citation-style">Citation style</label>
                  <select id="paper-citation-style" data-citation-selector>
                    {citations.map((citation) => (
                      <option value={citation.id} data-citation={citation.citation}>{citation.label}</option>
                    ))}
                  </select>
                </div>
                <button
                  type="button"
                  class="btn btn-small btn-outline copy-btn"
                  data-copy-target="#paper-citation"
                  aria-live="polite"
                >Copy citation</button>
              </div>

              <p id="paper-citation" class="citation-copy" aria-live="polite">{defaultCitation.citation}</p>
              <p class="paper-citation-note">
                Citation formats are generated from the official OASIS record. Confirm punctuation and capitalization against your instructor or publisher’s current style guide.
              </p>
            </div>
          </details>
        </section>
      </div>

      <aside class="paper-detail-sidebar" aria-label="Paper metadata and repository record">
        <section class="paper-detail-section paper-record-card" aria-labelledby="paper-details-title">
          <p class="paper-library-eyebrow">Paper record</p>
          <h2 id="paper-details-title">Publication details</h2>
          <dl class="paper-detail-list">
            <div class="paper-detail-row">
              <dt>Authors</dt>
              <dd>{authorsDisplay}</dd>
            </div>
            <div class="paper-detail-row">
              <dt>Semester</dt>
              <dd><a href={withBase(`/issues/${issueSlug}/`)}>{issueLabel}</a></dd>
            </div>
            {repositoryLabel ? (
              <div class="paper-detail-row">
                <dt>Repository issue</dt>
                <dd>{repositoryLabel}</dd>
              </div>
            ) : null}
            <div class="paper-detail-row">
              <dt>Published</dt>
              <dd>{publicationLabel}</dd>
            </div>
            <div class="paper-detail-row">
              <dt>Category</dt>
              <dd><a href={withBase(`/categories/${categorySlug}/`)}>{paper.data.category}</a></dd>
            </div>
            {paper.data.pages ? (
              <div class="paper-detail-row">
                <dt>Pages</dt>
                <dd>{paper.data.pages}</dd>
              </div>
            ) : null}
            {paper.data.advisor ? (
              <div class="paper-detail-row">
                <dt>Advisor</dt>
                <dd>{paper.data.advisor}</dd>
              </div>
            ) : null}
            {doiHref ? (
              <div class="paper-detail-row">
                <dt>DOI</dt>
                <dd><a href={doiHref} rel="external">{paper.data.doi}</a></dd>
              </div>
            ) : null}
          </dl>

          <div class="paper-record-topics">
            <h3 id="paper-keywords-title">Keywords</h3>
            <ul class="paper-detail-keywords">
              {paper.data.keywords.map((keyword) => <li>{keyword}</li>)}
            </ul>
          </div>
        </section>

        {showOasisLink ? (
          <section class="paper-repository-card" aria-labelledby="paper-repository-title">
            <p class="paper-repository-card__status">Preserved by UNLV Libraries</p>
            <h2 id="paper-repository-title">Official OASIS record</h2>
            <p>The institutional repository provides the permanent record, DOI, and full-text PDF.</p>
            <div class="paper-repository-card__actions">
              <a class="btn btn-small btn-primary" href={pdfHref}>Read PDF</a>
              <a class="paper-library-details-link" href={oasisUrl} rel="external">Repository record</a>
            </div>
          </section>
        ) : null}
      </aside>
    </article>
  </div>
</BaseLayout>

<script>
  const initializeCitationSelector = () => {
    const selector = document.querySelector("[data-citation-selector]");
    const output = document.querySelector("#paper-citation");
    if (!(selector instanceof HTMLSelectElement) || !(output instanceof HTMLElement)) {
      return;
    }

    const updateCitation = () => {
      const selected = selector.selectedOptions[0];
      const citation = selected?.dataset.citation;
      if (citation) {
        output.textContent = citation;
      }
    };

    selector.addEventListener("change", updateCitation);
    updateCitation();
  };

  document.addEventListener("astro:page-load", initializeCitationSelector);
  initializeCitationSelector();
</script>
