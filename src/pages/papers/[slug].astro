---
import PageBanner from "../../components/PageBanner.astro";
import { OASIS_MIRROR_ACTIVE } from "../../config/repositoryStatus";
import { categorySlugForName } from "../../data/categories";
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  cleanPaperTitle,
  formatCitation,
  formatPaperDate,
  getAllPapers,
  getIssueLabelForPaper,
  getIssueSlugForPaper,
  paperPdfHref,
  paperSlug,
  repositoryIssueLabel,
} from "../../lib/papers";
import { withBase } from "../../lib/urls";

export async function getStaticPaths() {
  const papers = await getAllPapers();
  return papers.map((paper) => ({ params: { slug: paperSlug(paper) }, props: { paper } }));
}

const { paper } = Astro.props;
const title = cleanPaperTitle(paper.data.title);
const issueLabel = getIssueLabelForPaper(paper);
const issueSlug = getIssueSlugForPaper(paper);
const categorySlug = categorySlugForName(paper.data.category);
const citation = formatCitation(paper);
const pdfHref = paperPdfHref(paper);
const oasisUrl = paper.data.oasis_url?.trim();
const showOasisLink = OASIS_MIRROR_ACTIVE && Boolean(oasisUrl);
const authorsDisplay = paper.data.authors.join(", ");
const publicationLabel = formatPaperDate(paper.data.published_at);
const repositoryLabel = repositoryIssueLabel(paper);
const doiHref = paper.data.doi ? `https://doi.org/${paper.data.doi}` : null;
---

<BaseLayout
  title={`${title} | Papers`}
  description={paper.data.abstract}
  bodyClass="section-papers page-paper-detail"
>
  <div class="paper-page">
    <PageBanner
      kicker="Undergraduate economics working paper"
      title={title}
      subtitle={`${authorsDisplay} • ${issueLabel} • ${publicationLabel}`}
    />

    <nav class="paper-detail-quick-actions content-section" aria-label="Paper actions">
      <a class="btn btn-primary" href={pdfHref}>Read full paper (PDF)</a>
      {showOasisLink ? (
        <a class="btn btn-small btn-outline" href={oasisUrl} rel="external">View OASIS record</a>
      ) : null}
      <a class="btn btn-small btn-outline" href={withBase("/papers/")}>All papers</a>
      <a class="btn btn-small btn-outline" href={withBase(`/issues/${issueSlug}/`)}>Back to {issueLabel}</a>
    </nav>

    <div class="paper-detail-layout content-section">
      <div class="paper-detail-main">
        <section class="paper-detail-section paper-abstract-card" aria-labelledby="paper-abstract-title">
          <p class="paper-library-eyebrow">Abstract</p>
          <h2 id="paper-abstract-title">Research summary</h2>
          <p class="paper-detail-abstract">{paper.data.abstract}</p>
        </section>

        <section class="paper-detail-section paper-citation-card" aria-labelledby="paper-citation-heading">
          <div class="paper-citation-head">
            <div>
              <p class="paper-library-eyebrow">Citation</p>
              <h2 id="paper-citation-heading">Recommended citation</h2>
            </div>
            <button
              type="button"
              class="btn btn-small btn-outline copy-btn"
              data-copy-target="#paper-citation"
              aria-live="polite"
            >Copy citation</button>
          </div>
          <div id="paper-citation" class="citation-copy">{citation}</div>
        </section>
      </div>

      <aside class="paper-detail-sidebar" aria-label="Paper metadata and repository record">
        <section class="paper-detail-section paper-meta-card" aria-labelledby="paper-details-title">
          <p class="paper-library-eyebrow">Paper record</p>
          <h2 id="paper-details-title">Publication details</h2>
          <dl class="paper-detail-list">
            <div class="paper-detail-row">
              <dt>Authors</dt>
              <dd>{authorsDisplay}</dd>
            </div>
            <div class="paper-detail-row">
              <dt>Semester</dt>
              <dd><a href={withBase(`/issues/${issueSlug}/`)}>{issueLabel}</a></dd>
            </div>
            {repositoryLabel ? (
              <div class="paper-detail-row">
                <dt>Repository issue</dt>
                <dd>{repositoryLabel}</dd>
              </div>
            ) : null}
            <div class="paper-detail-row">
              <dt>Published</dt>
              <dd>{publicationLabel}</dd>
            </div>
            <div class="paper-detail-row">
              <dt>Category</dt>
              <dd><a href={withBase(`/categories/${categorySlug}/`)}>{paper.data.category}</a></dd>
            </div>
            {paper.data.pages ? (
              <div class="paper-detail-row">
                <dt>Pages</dt>
                <dd>{paper.data.pages}</dd>
              </div>
            ) : null}
            {paper.data.advisor ? (
              <div class="paper-detail-row">
                <dt>Advisor</dt>
                <dd>{paper.data.advisor}</dd>
              </div>
            ) : null}
            {doiHref ? (
              <div class="paper-detail-row">
                <dt>DOI</dt>
                <dd><a href={doiHref} rel="external">{paper.data.doi}</a></dd>
              </div>
            ) : null}
          </dl>
        </section>

        <section class="paper-detail-section paper-keywords-card" aria-labelledby="paper-keywords-title">
          <p class="paper-library-eyebrow">Topics</p>
          <h2 id="paper-keywords-title">Keywords</h2>
          <ul class="paper-detail-keywords">
            {paper.data.keywords.map((keyword) => <li>{keyword}</li>)}
          </ul>
        </section>

        {showOasisLink ? (
          <section class="paper-repository-card" aria-labelledby="paper-repository-title">
            <p class="paper-repository-card__status">Preserved by UNLV Libraries</p>
            <h2 id="paper-repository-title">Official OASIS record</h2>
            <p>The institutional repository provides the permanent record, DOI, and full-text PDF.</p>
            <div class="paper-repository-card__actions">
              <a class="btn btn-small btn-primary" href={pdfHref}>Read PDF</a>
              <a class="paper-library-details-link" href={oasisUrl} rel="external">Repository record</a>
            </div>
          </section>
        ) : null}
      </aside>
    </div>
  </div>
</BaseLayout>
