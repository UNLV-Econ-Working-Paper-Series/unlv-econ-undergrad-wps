---
import "../../styles/pages/papers.css";
import { OASIS_MIRROR_ACTIVE } from "../../config/repositoryStatus";
import { OASIS } from "../../config/publication";
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  cleanPaperTitle,
  formatCitations,
  formatPaperDate,
  getAllPapers,
  getIssueLabelForPaper,
  getIssueSlugForPaper,
  paperPdfHref,
  paperSlug,
  repositoryIssueLabel,
} from "../../lib/papers";
import {
  buildScholarlyJsonLd,
  buildScholarlyMetaTags,
  citationExportHref,
  currentVersionLabel,
  doiUrl,
  formatAuthorDisplay,
  previousVersionStatusLabel,
  versionTimeline,
} from "../../lib/publication";
import { researchFieldSlug } from "../../lib/research-fields";
import { withBase } from "../../lib/urls";

export async function getStaticPaths() {
  const papers = await getAllPapers();
  return papers.map((paper) => ({ params: { slug: paperSlug(paper) }, props: { paper } }));
}

const { paper } = Astro.props;
const title = cleanPaperTitle(paper.data.title);
const slug = paperSlug(paper);
const issueLabel = getIssueLabelForPaper(paper);
const issueSlug = getIssueSlugForPaper(paper);
const fieldSlug = researchFieldSlug(paper.data.field);
const repositoryLabel = repositoryIssueLabel(paper);
const citations = formatCitations(paper);
const defaultCitation = citations[0];
const pdfHref = paperPdfHref(paper);
const oasisUrl = paper.data.oasis_url;
const showOasisLink = OASIS_MIRROR_ACTIVE && Boolean(oasisUrl);
const doiHref = paper.data.doi ? doiUrl(paper.data.doi) : null;
const versions = versionTimeline(paper.data);
const versionLabel = currentVersionLabel(paper.data.current_version);
const paperPath = `/papers/${slug}/`;
const issuePath = `/issues/${issueSlug}/`;
const siteUrl = Astro.site ?? new URL("https://econ-undergrad-wps.sites.unlv.edu");
const canonicalUrl = new URL(withBase(paperPath), siteUrl).toString();
const issueUrl = new URL(withBase(issuePath), siteUrl).toString();
const bibtexHref = withBase(citationExportHref("paper", slug, "bibtex"));
const risHref = withBase(citationExportHref("paper", slug, "ris"));
const scholarlyMeta = buildScholarlyMetaTags(paper.data, { canonicalUrl });
const jsonLd = buildScholarlyJsonLd(paper.data, { canonicalUrl, issueUrl });

const disclosures = [
  paper.data.rights_statement ? { label: "Rights statement", value: paper.data.rights_statement } : null,
  paper.data.copyright_holder ? { label: "Copyright holder", value: paper.data.copyright_holder } : null,
  paper.data.conflict_statement
    ? { label: "Conflict of interest", value: paper.data.conflict_statement }
    : null,
  paper.data.ai_disclosure ? { label: "AI disclosure", value: paper.data.ai_disclosure } : null,
  paper.data.ethics_statement ? { label: "Ethics statement", value: paper.data.ethics_statement } : null,
  paper.data.data_availability ? { label: "Data availability", value: paper.data.data_availability } : null,
  paper.data.code_availability ? { label: "Code availability", value: paper.data.code_availability } : null,
].filter((entry): entry is { label: string; value: string } => Boolean(entry));
---

<BaseLayout
  title={`${title} | UNLV Undergraduate Economics Working Paper Series`}
  description={paper.data.abstract}
  canonicalPath={paperPath}
  ogType="article"
  ogTitle={title}
  ogDescription={paper.data.abstract}
  articlePublishedAt={paper.data.citable_published_at}
  articleModifiedAt={paper.data.current_version.published_at}
  scholarlyMeta={scholarlyMeta}
  jsonLd={jsonLd}
  bodyClass="section-papers page-paper-detail paper-record-page"
>
  <link
    slot="head"
    rel="alternate"
    type="application/x-bibtex"
    href={bibtexHref}
    title={`BibTeX citation for ${title}`}
  />
  <link
    slot="head"
    rel="alternate"
    type="application/x-research-info-systems"
    href={risHref}
    title={`RIS citation for ${title}`}
  />
  <article class="paper-record-shell">
    <nav class="paper-record-breadcrumb" aria-label="Breadcrumb">
      <ol>
        <li><a href={withBase("/papers/")}>Working Papers</a></li>
        <li><a href={withBase(`/issues/${issueSlug}/`)}>{issueLabel}</a></li>
        <li><span aria-current="page">{title}</span></li>
      </ol>
    </nav>

    <header class="paper-record-header">
      <p class="paper-record-series">{paper.data.series_number}</p>
      <h1>{title}</h1>
      <p class="paper-record-byline">{formatAuthorDisplay(paper.data.authors)}</p>
      <p class="paper-record-notice">
        <strong>Working paper notice:</strong> This paper is a preliminary research output. It has undergone editorial
        screening but has not undergone external peer review. It may be revised.
      </p>
    </header>

    <nav class="paper-record-actions" aria-label="Paper access and citation actions">
      <a class="paper-record-action paper-record-action--primary" href={pdfHref}>Read full paper (PDF)</a>
      {
        showOasisLink ? (
          <a class="paper-record-action paper-record-action--repository" href={oasisUrl} rel="external">
            Permanent OAsis record
          </a>
        ) : null
      }
      {
        doiHref ? (
          <a class="paper-record-action" href={doiHref} rel="external">
            DOI
          </a>
        ) : null
      }
      <a class="paper-record-action" href={bibtexHref} download={`${slug}.bib`}>BibTeX</a>
      <a class="paper-record-action" href={risHref} download={`${slug}.ris`}>RIS</a>
      <button class="paper-record-action js-only" type="button" data-copy-target="#paper-citation-output"
        >Copy citation</button
      >
    </nav>

    <section class="paper-record-core" aria-labelledby="paper-core-heading">
      <h2 id="paper-core-heading">Paper record</h2>
      <dl>
        <div>
          <dt>Issue</dt>
          <dd><a href={withBase(`/issues/${issueSlug}/`)}>{issueLabel}</a></dd>
        </div>
        <div>
          <dt>Repository issue</dt>
          <dd>{repositoryLabel}</dd>
        </div>
        <div>
          <dt>Series number</dt>
          <dd>{paper.data.series_number}</dd>
        </div>
        {
          paper.data.issue_published_at ? (
            <div>
              <dt>Issue publication date</dt>
              <dd>
                <time datetime={paper.data.issue_published_at}>
                  {formatPaperDate(paper.data.issue_published_at)}
                </time>
              </dd>
            </div>
          ) : null
        }
        <div>
          <dt>Citable publication date</dt>
          <dd>
            <time datetime={paper.data.citable_published_at}
              >{formatPaperDate(paper.data.citable_published_at)}</time
            >
          </dd>
        </div>
        <div>
          <dt>OAsis online date</dt>
          <dd>
            <time datetime={paper.data.repository_published_at}
              >{formatPaperDate(paper.data.repository_published_at)}</time
            >
          </dd>
        </div>
        <div>
          <dt>Current version</dt>
          <dd>
            {versionLabel} · <time datetime={paper.data.current_version.published_at}
              >{formatPaperDate(paper.data.current_version.published_at)}</time
            >
            {paper.data.current_version.note ? <span> · {paper.data.current_version.note}</span> : null}
          </dd>
        </div>
        <div>
          <dt>Research field</dt>
          <dd><a href={withBase(`/fields/${fieldSlug}/`)}>{paper.data.field}</a></dd>
        </div>
        {
          paper.data.pages ? (
            <div>
              <dt>Pages</dt>
              <dd>{paper.data.pages}</dd>
            </div>
          ) : null
        }
        {
          paper.data.faculty_sponsor ? (
            <div>
              <dt>Faculty sponsor</dt>
              <dd>
                {paper.data.faculty_sponsor.profile_url ? (
                  <a href={paper.data.faculty_sponsor.profile_url} rel="external">
                    {paper.data.faculty_sponsor.name}
                  </a>
                ) : (
                  paper.data.faculty_sponsor.name
                )}
              </dd>
            </div>
          ) : null
        }
        {
          doiHref ? (
            <div>
              <dt>DOI</dt>
              <dd>
                <a href={doiHref} rel="external">
                  {paper.data.doi}
                </a>
              </dd>
            </div>
          ) : null
        }
      </dl>
    </section>

    <div class="paper-record-body">
      <div class="paper-record-main">
        <section class="paper-record-authors" aria-labelledby="paper-authors-heading">
          <h2 id="paper-authors-heading">Authors</h2>
          <ol>
            {
              paper.data.authors.map((author) => {
                const profile = author.institutional_profile ?? author.public_profile;
                return (
                  <li>
                    <p class="paper-record-author-name">
                      {profile ? (
                        <a href={profile} rel="external">
                          {author.name}
                        </a>
                      ) : (
                        author.name
                      )}
                    </p>
                    {author.affiliation ? <p>{author.affiliation}</p> : null}
                    {author.orcid ? (
                      <p>
                        <a href={author.orcid} rel="external">
                          ORCID
                        </a>
                      </p>
                    ) : null}
                  </li>
                );
              })
            }
          </ol>
        </section>

        <section class="paper-record-abstract" aria-labelledby="paper-abstract-heading">
          <h2 id="paper-abstract-heading">Abstract</h2>
          <p>{paper.data.abstract}</p>
        </section>

        <section class="paper-record-keywords" aria-labelledby="paper-keywords-heading">
          <h2 id="paper-keywords-heading">Keywords</h2>
          <p>{paper.data.keywords.join(", ")}</p>
        </section>

        <section class="paper-record-versions" aria-labelledby="paper-versions-heading">
          <h2 id="paper-versions-heading">Version history</h2>
          <ol>
            {
              versions.map((version) => (
                <li>
                  <div>
                    <strong>{version.label}</strong>
                    <span>
                      {version.status === "current" ? "Current" : previousVersionStatusLabel(version.status)}
                    </span>
                  </div>
                  <p>
                    <time datetime={version.publishedAt}>{formatPaperDate(version.publishedAt)}</time>
                    {version.note ? <span> · {version.note}</span> : null}
                  </p>
                  <p class="paper-record-version-links">
                    {version.oasisUrl ? (
                      <a href={version.oasisUrl} rel="external">
                        OAsis record
                      </a>
                    ) : null}
                    {version.publicUrl ? (
                      <a href={version.publicUrl} rel="external">
                        Public version
                      </a>
                    ) : null}
                  </p>
                </li>
              ))
            }
          </ol>
        </section>
      </div>

      <aside class="paper-record-secondary" aria-label="Citation and repository information">
        <details class="paper-record-details paper-record-citation">
          <summary>Cite this paper</summary>
          <div class="paper-record-details__body">
            <label class="js-only" for="paper-citation-style">Citation style</label>
            <select class="js-only" id="paper-citation-style" data-citation-selector>
              {
                citations.map((citation) => (
                  <option value={citation.id} data-citation={citation.citation}>
                    {citation.label}
                  </option>
                ))
              }
            </select>
            <p id="paper-citation-output" class="paper-record-citation-output" aria-live="polite">
              {defaultCitation.citation}
            </p>
            <button
              type="button"
              class="paper-record-action js-only"
              data-copy-target="#paper-citation-output">Copy citation</button
            >
            <p class="paper-record-citation-note">
              Confirm punctuation and capitalization against the current style guide required by your
              instructor or publisher.
            </p>
          </div>
        </details>

        <section class="paper-record-print-citation" aria-labelledby="paper-record-print-citation-heading">
          <h2 id="paper-record-print-citation-heading">Citation</h2>
          <p id="paper-citation-print-output" class="paper-record-citation-output">
            {defaultCitation.citation}
          </p>
        </section>

        <section class="paper-record-repository" aria-labelledby="repository-record-heading">
          <h2 id="repository-record-heading">Permanent repository record</h2>
          <p>{OASIS.safeDescription}</p>
          {
            showOasisLink ? (
              <a href={oasisUrl} rel="external">
                View this paper in OAsis
              </a>
            ) : null
          }
        </section>

        {
          disclosures.length > 0 || paper.data.license_url ? (
            <details class="paper-record-details">
              <summary>Rights and disclosures</summary>
              <div class="paper-record-details__body">
                <dl>
                  {disclosures.map((entry) => (
                    <div>
                      <dt>{entry.label}</dt>
                      <dd>{entry.value}</dd>
                    </div>
                  ))}
                  {paper.data.license_url ? (
                    <div>
                      <dt>License</dt>
                      <dd>
                        <a href={paper.data.license_url} rel="external">
                          View license terms
                        </a>
                      </dd>
                    </div>
                  ) : null}
                </dl>
              </div>
            </details>
          ) : null
        }

        {
          paper.data.historical_provenance ? (
            <details class="paper-record-details">
              <summary>Historical provenance</summary>
              <div class="paper-record-details__body">
                <dl>
                  <div>
                    <dt>Source</dt>
                    <dd>
                      {paper.data.historical_provenance.original_url ? (
                        <a href={paper.data.historical_provenance.original_url} rel="external">
                          {paper.data.historical_provenance.source_name}
                        </a>
                      ) : (
                        paper.data.historical_provenance.source_name
                      )}
                    </dd>
                  </div>
                  <div>
                    <dt>Original term</dt>
                    <dd>{paper.data.historical_provenance.original_term}</dd>
                  </div>
                  {paper.data.historical_provenance.original_publication_date ? (
                    <div>
                      <dt>Original publication date</dt>
                      <dd>{formatPaperDate(paper.data.historical_provenance.original_publication_date)}</dd>
                    </div>
                  ) : null}
                  {paper.data.historical_provenance.migrated_at ? (
                    <div>
                      <dt>Migration date</dt>
                      <dd>{formatPaperDate(paper.data.historical_provenance.migrated_at)}</dd>
                    </div>
                  ) : null}
                  <div>
                    <dt>Note</dt>
                    <dd>{paper.data.historical_provenance.note}</dd>
                  </div>
                </dl>
              </div>
            </details>
          ) : null
        }
      </aside>
    </div>
  </article>

  <script>
    const initializeCitationSelector = () => {
      const selector = document.querySelector("[data-citation-selector]");
      const output = document.querySelector("#paper-citation-output");
      const printOutput = document.querySelector("#paper-citation-print-output");
      if (!(selector instanceof HTMLSelectElement) || !(output instanceof HTMLElement)) return;
      if (selector.dataset.citationInit === "true") return;
      selector.dataset.citationInit = "true";

      const updateCitation = () => {
        const citation = selector.selectedOptions[0]?.dataset.citation;
        if (!citation) return;
        output.textContent = citation;
        if (printOutput instanceof HTMLElement) printOutput.textContent = citation;
      };
      selector.addEventListener("change", updateCitation);
      updateCitation();
    };

    document.addEventListener("astro:page-load", initializeCitationSelector);
    initializeCitationSelector();
  </script>
</BaseLayout>
