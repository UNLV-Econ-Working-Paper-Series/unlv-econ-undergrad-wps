---
import "../../styles/pages/papers.css";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { OASIS, SERIES } from "../../config/publication";
import {
  cleanPaperTitle,
  formatPaperDate,
  getAllPapers,
  getFieldGroups,
  getIssueGroups,
  getIssueLabelForPaper,
  getIssueSlugForPaper,
  paperHref,
  paperPdfHref,
  paperSlug,
  repositoryIssueLabel,
} from "../../lib/papers";
import {
  buildSearchIndexText,
  citationExportHref,
  doiUrl,
  parseSeriesIdentifier,
} from "../../lib/publication";
import { withBase } from "../../lib/urls";

const papers = await getAllPapers();
const fields = await getFieldGroups();
const issues = (await getIssueGroups()).filter((issue) => issue.papers.length > 0);
const paperCountLabel = `${papers.length} ${papers.length === 1 ? "paper" : "papers"}`;

const abstractExcerpt = (abstract: string, maximum = 240) => {
  if (abstract.length <= maximum) return abstract;
  const clipped = abstract.slice(0, maximum);
  const boundary = clipped.lastIndexOf(" ");
  return `${clipped.slice(0, boundary > maximum * 0.72 ? boundary : maximum).trim()}…`;
};
---

<BaseLayout
  title="Working Papers | UNLV Undergraduate Economics Working Paper Series"
  description="Search the UNLV Undergraduate Economics Working Paper Series by author, research field, issue, keyword, or topic."
  bodyClass="section-papers page-papers wps-catalog-page"
>
  <div class="wps-catalog-shell">
    <header class="wps-catalog-header">
      <h1>Working Papers</h1>
      <p>{SERIES.scope}</p>
      <p>
        The permanent repository records and deposited full texts are available through
        <a href={OASIS.collectionUrl} rel="external">OAsis</a>.
      </p>
    </header>

    {papers.length === 0 ? (
      <section class="wps-catalog-empty-state" aria-labelledby="empty-catalog-heading">
        <h2 id="empty-catalog-heading">No working papers are available</h2>
        <p>Please return when the first issue has been deposited.</p>
      </section>
    ) : (
      <section class="wps-catalog" aria-labelledby="catalog-heading">
        <div class="wps-catalog-heading">
          <h2 id="catalog-heading">Published collection</h2>
          <p id="paper-result-count" role="status" aria-live="polite" aria-atomic="true">
            Showing {paperCountLabel}
          </p>
        </div>

        <form class="wps-catalog-filters js-only" action={withBase("/papers/")} method="get" data-paper-filters>
          <div class="wps-catalog-filter wps-catalog-filter--search">
            <label for="paper-search">Search</label>
            <input
              id="paper-search"
              name="q"
              type="search"
              autocomplete="off"
              placeholder="Title, author, keyword, or topic"
              data-paper-search
            />
          </div>

          <div class="wps-catalog-filter">
            <label for="paper-field">Research Field</label>
            <select id="paper-field" name="field" data-paper-field>
              <option value="">All research fields</option>
              {fields.map((field) => (
                <option value={field.slug}>{field.name} ({field.count})</option>
              ))}
            </select>
          </div>

          <div class="wps-catalog-filter">
            <label for="paper-issue">Issue</label>
            <select id="paper-issue" name="issue" data-paper-issue>
              <option value="">All issues</option>
              {issues.map((issue) => (
                <option value={issue.slug}>{issue.label} ({issue.papers.length})</option>
              ))}
            </select>
          </div>

          <div class="wps-catalog-filter">
            <label for="paper-sort">Sort</label>
            <select id="paper-sort" name="sort" data-paper-sort>
              <option value="newest">Newest first</option>
              <option value="oldest">Oldest first</option>
              <option value="title">Title A–Z</option>
            </select>
          </div>

          <div class="wps-catalog-filter-actions">
            <button type="submit">Apply filters</button>
            <button type="button" class="wps-catalog-clear" data-paper-clear>Clear</button>
          </div>
        </form>
        <noscript>
          <p class="wps-catalog-noscript">Interactive filters require JavaScript. The complete unfiltered paper list appears below.</p>
        </noscript>

        <ol class="wps-paper-list" data-paper-list aria-label="Working paper results">
          {papers.map((paper) => {
            const title = cleanPaperTitle(paper.data.title);
            const issueSlug = getIssueSlugForPaper(paper);
            const issueLabel = getIssueLabelForPaper(paper);
            const repositoryLabel = repositoryIssueLabel(paper);
            const field = fields.find((candidate) => candidate.name === paper.data.field);
            const sequence = parseSeriesIdentifier(paper.data.series_number).sequence;
            const filename = paperSlug(paper);
            const bibtexHref = withBase(citationExportHref("paper", filename, "bibtex"));
            const risHref = withBase(citationExportHref("paper", filename, "ris"));
            const doiHref = paper.data.doi ? doiUrl(paper.data.doi) : null;

            return (
              <li
                data-paper-item
                data-search={buildSearchIndexText(paper.data)}
                data-field={field?.slug ?? ""}
                data-issue={issueSlug}
                data-citable={paper.data.citable_published_at}
                data-repository={paper.data.repository_published_at}
                data-sequence={sequence}
                data-title={title.toLocaleLowerCase("en-US")}
              >
                <article class="wps-paper-entry" aria-labelledby={`paper-title-${filename}`}>
                  <h3 id={`paper-title-${filename}`}><a href={paperHref(paper)}>{title}</a></h3>

                  <ul class="wps-paper-authors" aria-label={`Authors of ${title}`}>
                    {paper.data.authors.map((author) => {
                      const profile = author.institutional_profile ?? author.public_profile;
                      return (
                        <li>
                          {profile ? <a href={profile} rel="external">{author.name}</a> : <span>{author.name}</span>}
                          {author.affiliation ? <span class="wps-paper-affiliation">, {author.affiliation}</span> : null}
                        </li>
                      );
                    })}
                  </ul>

                  <dl class="wps-paper-metadata">
                    <div>
                      <dt>Research field</dt>
                      <dd>{field ? <a href={withBase(`/fields/${field.slug}/`)}>{paper.data.field}</a> : paper.data.field}</dd>
                    </div>
                    <div>
                      <dt>Issue</dt>
                      <dd><a href={withBase(`/issues/${issueSlug}/`)}>{issueLabel}</a>{repositoryLabel ? ` · ${repositoryLabel}` : ""}</dd>
                    </div>
                    <div>
                      <dt>Citable publication date</dt>
                      <dd><time datetime={paper.data.citable_published_at}>{formatPaperDate(paper.data.citable_published_at)}</time></dd>
                    </div>
                    <div>
                      <dt>OAsis online date</dt>
                      <dd><time datetime={paper.data.repository_published_at}>{formatPaperDate(paper.data.repository_published_at)}</time></dd>
                    </div>
                    <div>
                      <dt>Series number</dt>
                      <dd>{paper.data.series_number}</dd>
                    </div>
                    {doiHref ? (
                      <div>
                        <dt>DOI</dt>
                        <dd><a href={doiHref} rel="external">{paper.data.doi}</a></dd>
                      </div>
                    ) : null}
                  </dl>

                  <div class="wps-paper-abstract">
                    <h4>Abstract</h4>
                    <p>{abstractExcerpt(paper.data.abstract)}</p>
                  </div>

                  <p class="wps-paper-keywords"><strong>Keywords:</strong> {paper.data.keywords.join(", ")}</p>

                  <nav class="wps-paper-links" aria-label={`Access and citation links for ${title}`}>
                    <a href={paperHref(paper)}>Abstract and details</a>
                    <a href={paperPdfHref(paper)}>PDF</a>
                    <a href={bibtexHref} download={`${filename}.bib`}>BibTeX</a>
                    <a href={risHref} download={`${filename}.ris`}>RIS</a>
                  </nav>
                </article>
              </li>
            );
          })}
        </ol>

        <div class="wps-catalog-no-results js-only" data-paper-empty hidden>
          <h3>No working papers match these filters</h3>
          <p>Try a broader search, another issue, or another research field.</p>
          <button type="button" data-paper-empty-clear>Clear filters</button>
        </div>
      </section>
    )}
  </div>

  <script is:inline>
    (() => {
      const initializePaperCatalog = () => {
        const form = document.querySelector("[data-paper-filters]");
        const list = document.querySelector("[data-paper-list]");
        if (!(form instanceof HTMLFormElement) || !(list instanceof HTMLOListElement)) return;
        if (form.dataset.paperFiltersInit === "true") return;
        form.dataset.paperFiltersInit = "true";

        const search = form.querySelector("[data-paper-search]");
        const field = form.querySelector("[data-paper-field]");
        const issue = form.querySelector("[data-paper-issue]");
        const sort = form.querySelector("[data-paper-sort]");
        const empty = document.querySelector("[data-paper-empty]");
        const count = document.getElementById("paper-result-count");
        const clearButtons = document.querySelectorAll("[data-paper-clear], [data-paper-empty-clear]");
        const items = Array.from(list.querySelectorAll("[data-paper-item]"));

        if (
          !(search instanceof HTMLInputElement) ||
          !(field instanceof HTMLSelectElement) ||
          !(issue instanceof HTMLSelectElement) ||
          !(sort instanceof HTMLSelectElement)
        ) return;

        const normalize = (value) =>
          String(value || "")
            .normalize("NFKD")
            .replace(/[\u0300-\u036f]/g, "")
            .toLocaleLowerCase("en-US")
            .replace(/[^\p{L}\p{N}]+/gu, " ")
            .replace(/\s+/g, " ")
            .trim();

        const isAllowed = (select, value) =>
          Array.from(select.options).some((option) => option.value === value);

        const readUrl = () => {
          const params = new URL(window.location.href).searchParams;
          search.value = params.get("q") || "";
          const requestedField = params.get("field") || "";
          const requestedIssue = params.get("issue") || "";
          const requestedSort = params.get("sort") || "newest";
          field.value = isAllowed(field, requestedField) ? requestedField : "";
          issue.value = isAllowed(issue, requestedIssue) ? requestedIssue : "";
          sort.value = isAllowed(sort, requestedSort) ? requestedSort : "newest";
        };

        const currentUrl = () => {
          const url = new URL(form.action, window.location.href);
          const query = search.value.trim();
          if (query) url.searchParams.set("q", query);
          if (field.value) url.searchParams.set("field", field.value);
          if (issue.value) url.searchParams.set("issue", issue.value);
          if (sort.value && sort.value !== "newest") url.searchParams.set("sort", sort.value);
          return url;
        };

        const updateUrl = (mode) => {
          const next = currentUrl();
          const href = `${next.pathname}${next.search}${next.hash}`;
          if (href === `${window.location.pathname}${window.location.search}${window.location.hash}`) return;
          window.history[mode === "push" ? "pushState" : "replaceState"]({}, "", href);
        };

        const apply = () => {
          const query = normalize(search.value);
          const selectedField = field.value;
          const selectedIssue = issue.value;
          const sortMode = sort.value || "newest";

          items.forEach((item) => {
            const matchesSearch = !query || (item.dataset.search || "").includes(query);
            const matchesField = !selectedField || item.dataset.field === selectedField;
            const matchesIssue = !selectedIssue || item.dataset.issue === selectedIssue;
            item.hidden = !(matchesSearch && matchesField && matchesIssue);
          });

          const ordered = [...items].sort((a, b) => {
            if (sortMode === "title") return (a.dataset.title || "").localeCompare(b.dataset.title || "");
            const direction = sortMode === "oldest" ? 1 : -1;
            return (
              (a.dataset.citable || "").localeCompare(b.dataset.citable || "") * direction ||
              (Number(a.dataset.sequence || 0) - Number(b.dataset.sequence || 0)) * direction
            );
          });
          ordered.forEach((item) => list.appendChild(item));

          const visibleCount = items.filter((item) => !item.hidden).length;
          if (count) count.textContent = `Showing ${visibleCount} ${visibleCount === 1 ? "paper" : "papers"}`;
          if (empty instanceof HTMLElement) empty.hidden = visibleCount !== 0;
        };

        const applyAndUpdate = (mode) => {
          apply();
          updateUrl(mode);
        };

        form.addEventListener("submit", (event) => {
          event.preventDefault();
          applyAndUpdate("push");
        });
        search.addEventListener("input", () => applyAndUpdate("replace"));
        [field, issue, sort].forEach((control) => {
          control.addEventListener("change", () => applyAndUpdate("push"));
        });
        clearButtons.forEach((button) => {
          button.addEventListener("click", () => {
            search.value = "";
            field.value = "";
            issue.value = "";
            sort.value = "newest";
            applyAndUpdate("push");
            search.focus({ preventScroll: true });
          });
        });

        window.addEventListener("popstate", () => {
          if (!form.isConnected) return;
          readUrl();
          apply();
        });

        readUrl();
        apply();
        updateUrl("replace");
      };

      document.addEventListener("astro:page-load", initializePaperCatalog);
      initializePaperCatalog();
    })();
  </script>
</BaseLayout>
