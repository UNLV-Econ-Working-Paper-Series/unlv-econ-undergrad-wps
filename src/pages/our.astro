---
import BaseLayout from "../layouts/BaseLayout.astro";
import { withBase } from "../lib/urls";

const target = withBase("/for-authors/");
---

<BaseLayout
  title="For Student Authors | UNLV Undergraduate Economics Working Paper Series"
  description="Research Pathway has moved to the Series guidance for student authors."
  canonicalPath="/for-authors/"
  robots="noindex, follow"
  redirectTo={target}
  bodyClass="redirect-page"
>
  <section class="content-section">
    <h1>Research Pathway is now For Student Authors</h1>
    <p><a href={target}>Continue to For Student Authors</a></p>
  </section>
</BaseLayout>
