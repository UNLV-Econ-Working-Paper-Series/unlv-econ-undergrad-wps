---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { legacyRedirectTarget } from "../../lib/legacy-redirects";
import { withBase } from "../../lib/urls";

const canonicalPath = "/editorial-board/";
const target = withBase(legacyRedirectTarget("/graduate-assistants/")!);
---

<BaseLayout
  title="Junior Editors | UNLV Undergraduate Economics Working Paper Series"
  description="This legacy team page has moved to the Junior Editors section of the Editorial Board."
  canonicalPath={canonicalPath}
  robots="noindex, follow"
  redirectTo={target}
  bodyClass="redirect-page"
>
  <section class="content-section">
    <h1>This team page has moved to Junior Editors</h1>
    <p><a href={target}>Continue to Junior Editors</a></p>
  </section>
</BaseLayout>
