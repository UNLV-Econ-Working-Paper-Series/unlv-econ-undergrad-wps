---
import AboutNavigation from "../components/AboutNavigation.astro";
import PageBanner from "../components/PageBanner.astro";
import TableOfContents from "../components/TableOfContents.astro";
import { ABOUT_PAGE_CONTENT } from "../data/about-content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { withBase } from "../lib/urls";
---

<BaseLayout
  title="About | UNLV Undergraduate Economics Working Paper Series"
  bodyClass="section-about page-about page-about-modern"
>
  <PageBanner
    title={ABOUT_PAGE_CONTENT.banner.title}
    lead={ABOUT_PAGE_CONTENT.banner.lead}
    note={ABOUT_PAGE_CONTENT.banner.note}
  />

  <section class="content-section">
    <AboutNavigation currentHref="/about/" />

    <div class="page-with-toc">
      <div class="page-with-toc__toc">
        <TableOfContents items={ABOUT_PAGE_CONTENT.tocItems} />
      </div>

      <div class="page-with-toc__main">
        <div class="about-modern-shell">
          <section
            class="about-block about-card"
            id={ABOUT_PAGE_CONTENT.purpose.id}
            aria-labelledby="purpose-title"
          >
            <h2 id="purpose-title">{ABOUT_PAGE_CONTENT.purpose.title}</h2>
            {ABOUT_PAGE_CONTENT.purpose.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
          </section>

          <section
            class="about-block about-card"
            id={ABOUT_PAGE_CONTENT.scope.id}
            aria-labelledby="scope-title"
          >
            <h2 id="scope-title">{ABOUT_PAGE_CONTENT.scope.title}</h2>
            {ABOUT_PAGE_CONTENT.scope.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
            {
              ABOUT_PAGE_CONTENT.scope.points ? (
                <ul>
                  {ABOUT_PAGE_CONTENT.scope.points.map((point) => (
                    <li>{point}</li>
                  ))}
                </ul>
              ) : null
            }
            <p>
              <a href={withBase("/for-authors/")}>Read the complete guidance for student authors</a>.
            </p>
          </section>

          <section
            class="about-block about-card"
            id={ABOUT_PAGE_CONTENT.publicationStatus.id}
            aria-labelledby="publication-status-title"
          >
            <h2 id="publication-status-title">{ABOUT_PAGE_CONTENT.publicationStatus.title}</h2>
            {ABOUT_PAGE_CONTENT.publicationStatus.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
          </section>

          <section
            class="about-block about-card"
            id={ABOUT_PAGE_CONTENT.process.id}
            aria-labelledby="publication-process-title"
          >
            <h2 id="publication-process-title">{ABOUT_PAGE_CONTENT.process.title}</h2>
            <p>{ABOUT_PAGE_CONTENT.process.introduction}</p>
            <ol class="about-stepper">
              {
                ABOUT_PAGE_CONTENT.process.steps.map((step, index) => (
                  <li class="about-step-card">
                    <span class="about-step-number" aria-hidden="true">
                      {index + 1}
                    </span>
                    <h3>{step.title}</h3>
                    <p>{step.description}</p>
                  </li>
                ))
              }
            </ol>
          </section>

          <section
            class="about-block about-card"
            id={ABOUT_PAGE_CONTENT.repository.id}
            aria-labelledby="repository-title"
          >
            <h2 id="repository-title">{ABOUT_PAGE_CONTENT.repository.title}</h2>
            {ABOUT_PAGE_CONTENT.repository.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
            <p>
              <a href="https://oasis.library.unlv.edu/econ_ug_papers/">Visit the OAsis collection</a>.
            </p>
          </section>

          <section class="about-block about-card about-cta" aria-labelledby="about-cta-title">
            <h2 id="about-cta-title">{ABOUT_PAGE_CONTENT.cta.title}</h2>
            <p>{ABOUT_PAGE_CONTENT.cta.body}</p>
            <div class="page-intro-actions">
              {
                ABOUT_PAGE_CONTENT.cta.actions.map((action) => (
                  <a
                    class:list={["btn", "btn-small", action.primary ? "btn-primary" : "btn-outline"]}
                    href={withBase(action.href)}
                  >
                    {action.label}
                  </a>
                ))
              }
            </div>
          </section>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
