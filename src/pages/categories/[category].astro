---
import { CATEGORY_DEFINITIONS } from "../../data/categories";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { researchFieldHref } from "../../lib/research-fields";
import { withBase } from "../../lib/urls";

export function getStaticPaths() {
  return CATEGORY_DEFINITIONS.map((category) => ({
    params: { category: category.slug },
    props: { categoryName: category.name },
  }));
}

const { categoryName } = Astro.props as { categoryName: string };
const fieldPath = researchFieldHref(categoryName);
const target = withBase(fieldPath);
---

<BaseLayout
  title="Research Field Moved | UNLV Undergraduate Economics Working Paper Series"
  description="This legacy category URL now redirects to the corresponding controlled research field."
  canonicalPath={fieldPath}
  robots="noindex, follow"
  redirectTo={target}
  bodyClass="redirect-page"
>
  <section class="content-section">
    <h1>This category is now a Research Field</h1>
    <p><a href={target}>Continue to the research-field page</a></p>
  </section>
</BaseLayout>
