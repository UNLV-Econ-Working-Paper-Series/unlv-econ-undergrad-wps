---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { withBase } from "../../lib/urls";

const target = withBase("/fields/");
---

<BaseLayout title="Research Fields" canonicalPath="/fields/" robots="noindex, follow" redirectTo={target} bodyClass="redirect-page">
  <section class="content-section">
    <h1>This legacy category has moved</h1>
    <p><a href={target}>Continue to Research Fields</a></p>
  </section>
</BaseLayout>
