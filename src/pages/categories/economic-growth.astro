---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { withBase } from "../../lib/urls";

const target = withBase("/categories/");
---

<BaseLayout title="Category Moved" canonicalPath={target} robots="noindex, follow" redirectTo={target}>
  <article class="card content-section redirect-page">
    <h1>This legacy category is archived</h1>
    <p><a href={target}>Continue to Categories</a></p>
  </article>
</BaseLayout>
