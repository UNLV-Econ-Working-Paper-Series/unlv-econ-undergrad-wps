---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { legacyRedirectTarget } from "../../lib/legacy-redirects";
import { withBase } from "../../lib/urls";

const fieldPath = legacyRedirectTarget("/categories/economic-growth/")!;
const target = withBase(fieldPath);
---

<BaseLayout
  title="Research Fields"
  canonicalPath={fieldPath}
  robots="noindex, follow"
  redirectTo={target}
  bodyClass="redirect-page"
>
  <section class="content-section">
    <h1>This legacy category has moved</h1>
    <p><a href={target}>Continue to Research Fields</a></p>
  </section>
</BaseLayout>
