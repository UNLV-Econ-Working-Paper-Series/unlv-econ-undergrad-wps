---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { withBase } from "../../lib/urls";

const target = withBase("/fields/");
---

<BaseLayout
  title="Research Fields | UNLV Undergraduate Economics Working Paper Series"
  description="The former category directory has moved to Research Fields."
  canonicalPath="/fields/"
  robots="noindex, follow"
  redirectTo={target}
  bodyClass="redirect-page"
>
  <section class="content-section">
    <h1>Categories are now Research Fields</h1>
    <p><a href={target}>Continue to Research Fields</a></p>
  </section>
</BaseLayout>
