---
import PageBanner from "../../components/PageBanner.astro";
import { RESEARCH_FIELDS } from "../../config/publication";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getAllPapers, getIssueLabelForPaper } from "../../lib/papers";
import { requireResearchField, researchFieldSlug } from "../../lib/research-fields";
import { withBase } from "../../lib/urls";

const papers = await getAllPapers();
const fieldGroups = RESEARCH_FIELDS.map((field) => {
  const fieldPapers = papers.filter((paper) => requireResearchField(paper.data.category) === field);
  return {
    field,
    slug: researchFieldSlug(field),
    papers: fieldPapers,
    latestIssue: fieldPapers[0] ? getIssueLabelForPaper(fieldPapers[0]) : "",
  };
}).filter((group) => group.papers.length > 0);
---

<BaseLayout
  title="Research Fields | UNLV Undergraduate Economics Working Paper Series"
  description="Browse UNLV undergraduate economics working papers by controlled research field."
  bodyClass="section-fields page-fields"
>
  <PageBanner title="Research Fields" subtitle="Browse working papers by economics research field" />

  <section class="content-section" aria-labelledby="populated-fields-title">
    <header class="section-head">
      <div>
        <p class="eyebrow">Current collection</p>
        <h2 id="populated-fields-title">Fields represented in the Series</h2>
      </div>
    </header>

    <p>
      The Series uses a controlled field list so papers remain consistently discoverable. Only fields represented by a current paper
      appear below.
    </p>

    <ol class="field-directory" aria-label="Populated research fields">
      {fieldGroups.map((group) => (
        <li>
          <a href={withBase(`/fields/${group.slug}/`)}>
            <span>{group.field}</span>
            <span class="muted small">
              {group.papers.length} {group.papers.length === 1 ? "paper" : "papers"}
              {group.latestIssue ? ` · Latest issue: ${group.latestIssue}` : ""}
            </span>
          </a>
        </li>
      ))}
    </ol>

    <p class="muted small">
      The controlled taxonomy contains {RESEARCH_FIELDS.length} fields. Unpopulated fields are retained in the publication metadata
      standard but are not shown as empty public sections.
    </p>
  </section>
</BaseLayout>
