---
import PageBanner from "../../components/PageBanner.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { requireResearchField } from "../../lib/research-fields";
import { getIssueGroups } from "../../lib/papers";
import { withBase } from "../../lib/urls";

const issues = await getIssueGroups();
const publishedIssues = issues.filter((issue) => issue.papers.length > 0);
const hasPublishedIssues = publishedIssues.length > 0;
const issuesIntro = hasPublishedIssues
  ? "Browse issues by semester. Each issue groups the papers posted for that term"
  : "Current issue listings will be posted soon.";

const issueFieldMap = new Map(
  publishedIssues.map((issue) => [
    issue.slug,
    [...new Set(issue.papers.map((paper) => requireResearchField(paper.data.category)))].sort((a, b) => a.localeCompare(b)),
  ])
);

const years = [...new Set(publishedIssues.map((issue) => issue.year).filter((year): year is number => typeof year === "number"))].sort(
  (a, b) => b - a
);
const fields = [...new Set([...issueFieldMap.values()].flat())].sort((a, b) => a.localeCompare(b));
const countLabel = (count: number, singular: string, plural = `${singular}s`): string =>
  `${count} ${count === 1 ? singular : plural}`;
---

<BaseLayout title="Issues | UNLV Undergraduate Economics Working Paper Series" bodyClass="section-issues page-issues">
  <PageBanner title="Issues" subtitle={issuesIntro} />

  <section class="issues-explorer content-section">
    {hasPublishedIssues ? (
      <>
        <section class="issues-controls issues-controls--modern" aria-label="Issue filters">
          <div class="issues-search">
            <label for="issues-search">Search papers</label>
            <input id="issues-search" type="search" placeholder="Search papers..." />
          </div>

          <div class="issues-filter-row issues-filter-row--selects">
            <div class="issues-year-filter">
              <label class="issues-filter-label" for="issues-year">Year</label>
              <select id="issues-year">
                <option value="">All years</option>
                {years.map((year) => (
                  <option value={String(year)}>{year}</option>
                ))}
              </select>
            </div>

            <div class="issues-category-filter">
              <label class="issues-filter-label" for="issues-field">Research field</label>
              <select id="issues-field">
                <option value="">All research fields</option>
                {fields.map((field) => (
                  <option value={field.toLowerCase()}>{field}</option>
                ))}
              </select>
            </div>
          </div>
        </section>

        <p class="filter-result-count" id="issues-result-count" role="status" aria-live="polite" aria-atomic="true">
          Showing {publishedIssues.length} {publishedIssues.length === 1 ? "issue" : "issues"}
        </p>

        <section class="issues-cards" aria-label="Issue cards">
          {publishedIssues.map((issue, index) => {
            const issueFields = issueFieldMap.get(issue.slug) ?? [];
            const searchText = [
              issue.label,
              ...issue.papers.map((paper) => paper.data.title),
              ...issue.papers.flatMap((paper) => paper.data.authors),
              ...issue.papers.flatMap((paper) => paper.data.keywords),
              ...issue.papers.map((paper) => paper.data.abstract),
              ...issueFields,
            ]
              .join(" ")
              .toLowerCase();

            return (
              <article
                class="issue-archive-card card"
                data-motion="gsap"
                data-issue-card
                data-year={issue.year === null ? "unknown" : String(issue.year)}
                data-fields={issueFields.map((field) => field.toLowerCase()).join("|")}
                data-search={searchText}
              >
                <header class="issue-archive-head">
                  {index === 0 ? <p class="issue-latest-badge">Latest issue</p> : null}
                  <h2>{issue.label}</h2>
                  <p class="issue-card-meta">
                    {countLabel(issue.papers.length, "paper")} • {countLabel(issueFields.length, "research field")}
                  </p>
                </header>

                <div class="issue-topic-chips" role="list" aria-label={`Research fields in ${issue.label}`}>
                  {issueFields.slice(0, 5).map((field) => (
                    <span class="issue-topic-chip" role="listitem">{field}</span>
                  ))}
                  {issueFields.length > 5 ? <span class="issue-topic-chip" role="listitem">+{issueFields.length - 5} more</span> : null}
                </div>

                <div class="issue-card-actions">
                  <a class="btn btn-small btn-primary" href={withBase(`/issues/${issue.slug}/`)}>Browse issue</a>
                </div>
              </article>
            );
          })}
        </section>
        <p id="issues-empty" class="muted small" hidden>No issues match those filters</p>
      </>
    ) : (
      <article class="accent-card empty-state-card" data-motion="gsap">
        <h2>Coming soon</h2>
        <p class="muted">Issue listings will be posted soon.</p>
      </article>
    )}

    <section class="issues-archive-container">
      <a class="issue-archive-card issue-archive-link card" data-motion="gsap" href={withBase("/issues/archive/")}>
        <h3>Legacy Archive</h3>
        <p>Browse verified historical working-paper records</p>
      </a>
    </section>
  </section>

  <script is:inline>
    (() => {
      const initIssueFilters = () => {
        const explorer = document.querySelector(".page-issues .issues-explorer");
        if (!(explorer instanceof HTMLElement) || explorer.dataset.filtersInit === "true") return;
        explorer.dataset.filtersInit = "true";

        const searchInput = explorer.querySelector("#issues-search");
        const yearSelect = explorer.querySelector("#issues-year");
        const fieldSelect = explorer.querySelector("#issues-field");
        const issueCards = Array.from(explorer.querySelectorAll("[data-issue-card]"));
        const emptyState = explorer.querySelector("#issues-empty");
        const resultCount = explorer.querySelector("#issues-result-count");

        const applyFilters = () => {
          const query = (searchInput?.value || "").trim().toLowerCase();
          const selectedYear = (yearSelect?.value || "").trim();
          const selectedField = (fieldSelect?.value || "").trim();

          issueCards.forEach((card) => {
            const year = card.dataset.year || "";
            const search = card.dataset.search || "";
            const fields = (card.dataset.fields || "").split("|").filter(Boolean);
            const visible = (!selectedYear || year === selectedYear) &&
              (!selectedField || fields.includes(selectedField)) &&
              (!query || search.includes(query));
            card.hidden = !visible;
          });

          const visibleCount = issueCards.filter((card) => !card.hidden).length;
          if (emptyState instanceof HTMLElement) emptyState.hidden = visibleCount !== 0;
          if (resultCount instanceof HTMLElement) {
            resultCount.textContent = `Showing ${visibleCount} of ${issueCards.length} ${issueCards.length === 1 ? "issue" : "issues"}`;
          }
        };

        searchInput?.addEventListener("input", applyFilters);
        yearSelect?.addEventListener("change", applyFilters);
        fieldSelect?.addEventListener("change", applyFilters);
        applyFilters();
      };

      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", initIssueFilters, { once: true });
      } else {
        initIssueFilters();
      }
      document.addEventListener("astro:page-load", initIssueFilters);
    })();
  </script>
</BaseLayout>
