---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { getAllPapers, getIssueSlugForPaper, paperSlug } from "../../../lib/papers";
import { withBase } from "../../../lib/urls";
import "../../../styles/pages/issues.css";

export async function getStaticPaths() {
  const papers = await getAllPapers();
  const paths = [];

  for (const paper of papers) {
    const match = paper.data.pdf_url.match(/\/(paper-\d+)\.pdf$/i);
    const legacyPaperSlug = match?.[1] ?? null;
    if (!legacyPaperSlug) {
      continue;
    }

    paths.push({
      params: {
        issue: getIssueSlugForPaper(paper),
        paper: legacyPaperSlug,
      },
      props: {
        target: withBase(`/papers/${paperSlug(paper)}/`),
      },
    });
  }

  return paths;
}

const { target } = Astro.props;
---

<BaseLayout
  title="Paper record moved | UNLV Undergraduate Economics Working Paper Series"
  robots="noindex, follow"
  canonicalPath={target}
  redirectTo={target}
  bodyClass="section-issues page-paper-redirect"
>
  <article class="redirect-notice content-section">
    <h1>This paper record has moved</h1>
    <p>The earlier issue-based address now points to the paper’s canonical record.</p>
    <p><a class="text-action" href={target}>Continue to the paper record<span aria-hidden="true"> →</span></a></p>
  </article>
  <script is:inline define:vars={{ target }}>
    window.location.replace(target);
  </script>
</BaseLayout>
