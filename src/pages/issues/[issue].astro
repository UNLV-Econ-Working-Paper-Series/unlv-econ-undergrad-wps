---
import PageBanner from "../../components/PageBanner.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  cleanPaperTitle,
  formatPaperDate,
  getIssueGroups,
  type IssueGroup,
  paperHref,
  repositoryIssueLabel,
} from "../../lib/papers";
import { doiUrl, formatAuthorDisplay } from "../../lib/publication";
import { researchFieldSlug } from "../../lib/research-fields";
import { withBase } from "../../lib/urls";
import "../../styles/pages/issues.css";

export async function getStaticPaths() {
  const issues = await getIssueGroups();
  return issues.map((issue) => ({ params: { issue: issue.slug }, props: { issue } }));
}

const { issue } = Astro.props as { issue: IssueGroup };
const papers = issue.papers;
const fieldCount = new Set(papers.map((paper) => paper.data.field)).size;
const repositoryDates = [...new Set(papers.map((paper) => paper.data.repository_published_at))].sort();
const finalRepositoryDate = repositoryDates[repositoryDates.length - 1];
const bibliographicLabels = [...new Set(papers.map(repositoryIssueLabel).filter(Boolean))];
const bibliographicLabel = bibliographicLabels.length === 1 ? bibliographicLabels[0] : null;

const countLabel = (count: number, singular: string, plural = `${singular}s`): string =>
  `${count} ${count === 1 ? singular : plural}`;
---

<BaseLayout
  title={`${issue.label} | Issues | UNLV Undergraduate Economics Working Paper Series`}
  description={`Paper records and publication metadata for the ${issue.label} issue of the UNLV Undergraduate Economics Working Paper Series.`}
  bodyClass="section-issues page-issue-detail"
>
  <nav class="publication-breadcrumb content-section" aria-label="Breadcrumb">
    <ol>
      <li><a href={withBase("/issues/")}>Issues</a></li>
      <li><span aria-current="page">{issue.label}</span></li>
    </ol>
  </nav>

  <PageBanner
    kicker="Semester issue"
    title={issue.label}
    subtitle={bibliographicLabel ?? "Issue metadata"}
    compact
  />

  <section class="issue-detail content-section" aria-labelledby="issue-summary-title">
    {papers.length > 0 ? (
      <>
        <header class="issue-detail__summary">
          <div class="issue-detail__introduction">
            <p class="publication-label">Issue overview</p>
            <h2 id="issue-summary-title">{issue.label} issue</h2>
            <p>
              This issue contains {countLabel(papers.length, "working paper")} across {countLabel(fieldCount, "research field")}.
              Each paper has its own citable record and full-text link.
            </p>
            <p class="issue-detail__date">
              {repositoryDates.length === 1 ? (
                <>Added to OAsis <time datetime={repositoryDates[0]}>{formatPaperDate(repositoryDates[0])}</time>.</>
              ) : repositoryDates.length > 1 ? (
                <>
                  Papers added to OAsis between <time datetime={repositoryDates[0]}>{formatPaperDate(repositoryDates[0])}</time>
                  {" and "}
                  <time datetime={finalRepositoryDate}>{formatPaperDate(finalRepositoryDate)}</time>.
                </>
              ) : null}
            </p>
          </div>

          <dl class="issue-facts" aria-label={`${issue.label} issue facts`}>
            {bibliographicLabel ? (
              <div>
                <dt>Bibliographic issue</dt>
                <dd>{bibliographicLabel}</dd>
              </div>
            ) : null}
            <div>
              <dt>Working papers</dt>
              <dd>{papers.length}</dd>
            </div>
            <div>
              <dt>Research fields</dt>
              <dd>{fieldCount}</dd>
            </div>
          </dl>
        </header>

        <section class="issue-contents" aria-labelledby="issue-contents-title">
          <header class="issue-contents__header">
            <p class="publication-label">Table of contents</p>
            <h2 id="issue-contents-title">Papers in This Issue</h2>
          </header>

          <ol class="issue-paper-list">
            {papers.map((paper) => {
              const title = cleanPaperTitle(paper.data.title);
              const fieldHref = withBase(`/fields/${researchFieldSlug(paper.data.field)}/`);

              return (
                <li>
                  <article class="issue-paper-entry">
                    <div class="issue-paper-entry__main">
                      <p class="paper-series-number">{paper.data.series_number}</p>
                      <h3><a href={paperHref(paper)}>{title}</a></h3>
                      <p class="paper-byline">{formatAuthorDisplay(paper.data.authors)}</p>
                    </div>

                    <dl class="paper-compact-metadata">
                      <div>
                        <dt>Research field</dt>
                        <dd><a href={fieldHref}>{paper.data.field}</a></dd>
                      </div>
                      {paper.data.doi ? (
                        <div>
                          <dt>DOI</dt>
                          <dd><a href={doiUrl(paper.data.doi)} rel="external">{paper.data.doi}</a></dd>
                        </div>
                      ) : null}
                    </dl>

                    <p class="issue-paper-entry__action">
                      <a class="text-action" href={paperHref(paper)}>View paper record<span aria-hidden="true"> →</span></a>
                      <a href={paper.data.pdf_url} rel="external">Full text PDF</a>
                    </p>
                  </article>
                </li>
              );
            })}
          </ol>
        </section>

        <p class="issue-back-link"><a href={withBase("/issues/")}>← All published issues</a></p>
      </>
    ) : (
      <section class="publication-empty" aria-labelledby="issue-summary-title">
        <p class="publication-label">Publication status</p>
        <h2 id="issue-summary-title">No published papers are listed for this issue</h2>
        <p>The page will be updated after a verified paper record is available.</p>
        <p><a href={withBase("/issues/")}>Return to published issues</a></p>
      </section>
    )}
  </section>
</BaseLayout>
